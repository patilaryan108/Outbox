{
  "name": "email-job-scheduler",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:worker": "npm run worker:dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "db:generate": "npm run db:generate --workspace backend",
    "db:migrate": "npm run db:deploy --workspace backend",
    "db:seed": "npm run db:seed --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "demo": "npm run build && node scripts/demo.mjs"
  }
}
